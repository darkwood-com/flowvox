{
    "settings": {
        "enable_pull_to_refresh": true
    },
    "rules": [
        {
            "patterns": [
                ".*"
            ],
            "properties": {
                "context": "default",
                "pull_to_refresh_enabled": true
            }
        },
        {
            "patterns": [
                "/session/.*"
            ],
            "properties": {
                "pull_to_refresh_enabled": false
            }
        }
    ]
}