{% extends 'base.html.twig' %}

{% block title %}Settings — Flowvox{% endblock %}

{% block body %}
<h1>Settings</h1>

<section>
    <h2>Transcription provider</h2>
    <p>Current: <code>{{ current }}</code> (set <code>FLOWVOX_TRANSCRIPTION_PROVIDER</code> in <code>.env.local</code>)</p>
    <ul>
        {% for p in providers %}
            <li><code>{{ p }}</code></li>
        {% endfor %}
    </ul>
</section>

<section>
    <h2>Whisper stream (local realtime)</h2>
    <p>Mode: <code>{{ whisperMode }}</code> (<code>FLOWVOX_WHISPER_MODE</code>: <code>batch</code> or <code>stream</code>)</p>
    <p>Binary: <code>{{ whisperStreamPath ?: '(not set)' }}</code> — set <code>WHISPER_STREAM_PATH</code> to <code>whisper-stream</code> built with <code>WHISPER_SDL2=ON</code>.</p>
    <p>Provider <code>whisper_cpp_stream</code> is available when using stream mode. Requires SDL2 (<code>brew install sdl2</code> on macOS).</p>
    <p>Only one app can use the microphone at a time — do not run ffmpeg recording and whisper-stream together.</p>
    <p>Microphone selection (IDs differ between modes):</p>
    <ul>
        <li>Stream: <code>WHISPER_STREAM_CAPTURE_ID={{ whisperStreamCaptureId }}</code> (<code>-1</code> = macOS/SDL default)</li>
        <li>Batch: <code>WHISPER_FFMPEG_CAPTURE_DEVICE={{ whisperFfmpegCaptureDevice }}</code> (ffmpeg <code>:N</code>)</li>
    </ul>
    <p>Run <code>php bin/console voice:list-capture-devices</code> to list available devices.</p>
</section>

<section>
    <h2>OpenAI</h2>
    <p>{% if openaiConfigured %}API key configured.{% else %}Set <code>OPENAI_API_KEY</code> for cloud modes.{% endif %}</p>
</section>

{% if ux_is_native() %}
<section>
    <h2>Native app</h2>
    <p
        data-controller="microphone-permission"
        data-action="microphone-permission:granted->microphone-permission#onGranted"
    >
        Microphone: requesting permission via native bridge…
    </p>
</section>
{% endif %}
{% endblock %}
