{% extends 'base.html.twig' %}

{% block title %}Settings — Flowvox{% endblock %}

{% block body %}
<h1>Settings</h1>

<section>
    <h2>Transcription provider</h2>
    <p>Current: <code>{{ current }}</code> (set <code>FLOWVOX_TRANSCRIPTION_PROVIDER</code> in <code>.env.local</code>)</p>
    <ul>
        {% for p in providers %}
            <li><code>{{ p }}</code></li>
        {% endfor %}
    </ul>
</section>

<section>
    <h2>OpenAI</h2>
    <p>{% if openaiConfigured %}API key configured.{% else %}Set <code>OPENAI_API_KEY</code> for cloud modes.{% endif %}</p>
</section>

{% if ux_is_native() %}
<section>
    <h2>Native app</h2>
    <p data-controller="microphone-permission">Microphone permission bridge active.</p>
</section>
{% endif %}
{% endblock %}
