{% extends 'base.html.twig' %}

{% block title %}Session {{ session.id }} — Flowvox{% endblock %}

{% block body %}
<h1>Session <code>{{ session.id }}</code></h1>
<p>
    <span class="badge badge-{{ session.status.value }}" id="session-status-badge">{{ session.status.value }}</span>
    <span class="muted" id="session-meta">
        PID {{ session.pid }}
        · {{ session.provider.value }}
        {% if whisperStreamMode %} · mic stream{% endif %}
        {% if configuredProvider != session.provider.value %}
            <span class="hint">(config: {{ configuredProvider }})</span>
        {% endif %}
    </span>
</p>

{% include 'session/_controls_frame.html.twig' with {sessionId: session.id} %}

{% if openAiRealtimeMode %}
<p class="hint">OpenAI Realtime: text appears while you speak (VAD segments). STOP finalizes the session.</p>
{% elseif whisperStreamMode %}
<p class="hint">Whisper stream: text updates every ~{{ (whisperStreamStepMs / 1000)|round(1) }}s while you speak. STOP saves the final transcript.</p>
{% endif %}

<section
    class="live-transcript"
    data-controller="live-transcript"
    data-live-transcript-url-value="{{ mercure(mercure_topic, { subscribe: [mercure_topic, '/voice/dashboard'] }) }}"
>
    <h2>Live transcription</h2>
    <div id="live-transcript-content" data-live-transcript-target="content">
        <p class="muted">Waiting for events…</p>
    </div>
</section>

<h2>History</h2>
<ul class="list">
    {% for t in transcriptions %}
        <li>
            <a href="{{ path('transcription_show', {id: t.id}) }}">{{ t.createdAt|date('Y-m-d H:i:s') }}</a>
            — {{ t.fullText|length > 100 ? t.fullText|slice(0, 100) ~ '…' : t.fullText }}
        </li>
    {% else %}
        <li class="muted">No transcriptions for this session yet.</li>
    {% endfor %}
</ul>
{% endblock %}
